{
  "name": "chronex-server",
  "version": "1.0.0",
  "description": "CHRONEX Luxury Watch Store — Express API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json,env --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "ts-node src/seed.ts",
    "redis:start": "powershell -ExecutionPolicy Bypass -File .\\Start-Redis.ps1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.3",
    "stripe": "^14.10.0",
    "nodemailer": "^6.9.7",
    "ioredis": "^5.3.2",
    "socket.io": "^4.6.2",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "uuid": "^9.0.1",
    "slugify": "^1.6.6",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}
